{
  "info": {
    "name": "Course Management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "courseId",
      "value": ""
    },
    {
      "key": "moduleId",
      "value": ""
    },
    {
      "key": "contentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "users",
      "item": [
        {
          "name": "List",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/users",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sample User\",\n  \"email\": \"sample@example.com\",\n  \"status\": \"active\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set('userId', pm.response.json().id)"
                ]
              }
            }
          ]
        },
        {
          "name": "Find",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/{{userId}}"
          }
        },
        {
          "name": "Update",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/users/{{userId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated User\"\n}"
            }
          }
        },
        {
          "name": "Delete",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/users/{{userId}}"
          }
        }
      ]
    },
    {
      "name": "courses",
      "item": [
        {
          "name": "List",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/courses"
          }
        },
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/courses",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"SAMPLE-01\",\n  \"title\": \"Sample Course\",\n  \"description\": \"Sample description\",\n  \"userId\": \"{{userId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set('courseId', pm.response.json().id)"
                ]
              }
            }
          ]
        },
        {
          "name": "Find",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/courses/{{courseId}}"
          }
        },
        {
          "name": "Update",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/courses/{{courseId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Title\"\n}"
            }
          }
        },
        {
          "name": "Delete",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/courses/{{courseId}}"
          }
        }
      ]
    },
    {
      "name": "modules",
      "item": [
        {
          "name": "List",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/modules"
          }
        },
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/modules",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courseId\": \"{{courseId}}\",\n  \"title\": \"Sample Module\",\n  \"description\": \"Sample description\",\n  \"userId\": \"{{userId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set('moduleId', pm.response.json().id)"
                ]
              }
            }
          ]
        },
        {
          "name": "Find",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/modules/{{moduleId}}"
          }
        },
        {
          "name": "Update",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/modules/{{moduleId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Title\"\n}"
            }
          }
        },
        {
          "name": "Delete",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/modules/{{moduleId}}"
          }
        }
      ]
    },
    {
      "name": "contents",
      "item": [
        {
          "name": "List",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/contents"
          }
        },
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/contents",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"moduleId\": \"{{moduleId}}\",\n  \"title\": \"Sample Lesson\",\n  \"content\": \"Lesson text\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set('contentId', pm.response.json().id)"
                ]
              }
            }
          ]
        },
        {
          "name": "Find",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/contents/{{contentId}}"
          }
        },
        {
          "name": "Update",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/contents/{{contentId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Title\"\n}"
            }
          }
        },
        {
          "name": "Delete",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/contents/{{contentId}}"
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "users-most-courses",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/reports/users-most-courses"
          }
        },
        {
          "name": "course-most-contents",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/reports/course-most-contents"
          }
        },
        {
          "name": "courses-metrics",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/reports/courses-metrics"
          }
        },
        {
          "name": "contents-with-course",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/reports/contents-with-course"
          }
        },
        {
          "name": "watched-content/2",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/reports/watched-content/2"
          }
        },
        {
          "name": "Mark as watched",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/users/{{userId}}/watched/{{contentId}}"
          }
        }
      ]
    }
  ]
}
